# Copy this file to ".env" (same folder) and paste your own key after the "=".
# Never paste the key into chat and never commit .env (it is in .gitignore).
GEMINI_API_KEY=

# Which LLM backend to use: "gemini" (free tier, cloud) or "ollama" (local, unlimited)
LLM_PROVIDER=gemini

# Optional settings (the defaults are in ragagent/config.py)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# LLM_CACHE=1                 # 1 = replay identical requests from .cache/llm (saves free quota)
# AGENT_EXTRACT_TOOL=1        # 1 = the agent may call extract_fields (default); 0 = off, e.g. while hand-labeling new documents

# Only for `python -m ragagent.download` (re-downloading the SEC documents):
# SEC asks every script to identify itself with a name and an email.
# SEC_USER_AGENT=Your Name you@example.com
